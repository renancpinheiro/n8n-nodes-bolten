[
    {
        "name": "opportunityId",
        "type": "text",
        "label": "Opportunity ID",
        "required": true
    },
    {
        "name": "title",
        "type": "text",
        "label": "Title",
        "required": true
    },
    {
        "name": "state",
        "type": "select",
        "label": "State",
        "required": true,
        "default": "to_do",
        "options": [
            { "label": "To Do", "value": "to_do" },
            { "label": "Doing", "value": "doing" },
            { "label": "Done", "value": "done" }
        ]
    },
    {
        "name": "description",
        "type": "text",
        "label": "Description",
        "required": false
    },
    {
        "name": "scheduledTo",
        "type": "date",
        "label": "Scheduled To",
        "required": false
    }
]

{
    "url": "https://app.bolten.io/clients/api/v1/projects",
    "method": "GET",
    "headers": {
        "authorization": "Bearer {{parameters.apiKey}}"
    },
    "response": {
        "data": {
            "apiKey": "{{parameters.apiKey}}"
        },
        "error": {
            "message": "[{{statusCode}}] Invalid API key. Generate a key in Bolten under Settings › Advanced Settings › API."
        }
    },
    "log": {
        "sanitize": [
            "request.headers.authorization"
        ]
    }
}

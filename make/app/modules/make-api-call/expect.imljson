[
    {
        "name": "url",
        "type": "text",
        "label": "URL",
        "required": true,
        "help": "Path relative to `https://app.bolten.io`, without a leading slash. For example: `clients/api/v1/projects`."
    },
    {
        "name": "method",
        "type": "select",
        "label": "Method",
        "required": true,
        "default": "GET",
        "options": [
            {
                "label": "GET",
                "value": "GET"
            },
            {
                "label": "POST",
                "value": "POST"
            },
            {
                "label": "PATCH",
                "value": "PATCH"
            },
            {
                "label": "PUT",
                "value": "PUT"
            },
            {
                "label": "DELETE",
                "value": "DELETE"
            }
        ],
        "mode": "edit"
    },
    {
        "name": "qs",
        "type": "array",
        "label": "Query string",
        "required": false,
        "spec": [
            {
                "name": "key",
                "type": "text",
                "label": "Key",
                "required": true
            },
            {
                "name": "value",
                "type": "text",
                "label": "Value"
            }
        ]
    },
    {
        "name": "body",
        "type": "any",
        "label": "Body",
        "required": false
    }
]
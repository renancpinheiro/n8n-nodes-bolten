{
    "url": "/clients/api/v1/projects/{{parameters.projectId}}/components",
    "method": "GET",
    "qs": {
        "page": 1,
        "limit": 100
    },
    "response": {
        "iterate": {
            "container": "{{body.items}}",
            "condition": "{{if(parameters.category, item.category = parameters.category, true)}}"
        },
        "output": {
            "label": "{{item.name}}",
            "value": "{{item.id}}"
        },
        "limit": 300
    },
    "pagination": {
        "qs": {
            "page": "{{pagination.page}}"
        },
        "condition": "{{length(body.items) > 0}}"
    }
}
